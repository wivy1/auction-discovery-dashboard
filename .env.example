# Copy to .env.local. Dashboard Settings stores your active origin locally.
APP_NAME="Auction Discovery"
ORIGIN_POSTAL_CODE=90210
ORIGIN_COUNTRY=US
DEFAULT_TIME_ZONE=America/Los_Angeles

# Optional text-only enrichment. Leave blank for ordinary Unrated review.
# Configure installed Ollama models explicitly; setup never downloads AI models.
AI_TEXT_PROVIDER=
AI_TEXT_MODEL=
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
AI_TEXT_CONCURRENCY=1
AI_TIMEOUT_MS=180000
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=1200

# Source access is opt-in in source-adapters.local.ts and dashboard Settings.
# Adapters declare their own permitted hosts, pacing and request ceilings.
SOURCE_TIMEOUT_MS=30000
PIPELINE_MAX_CANDIDATES_PER_SOURCE=30
PIPELINE_MAX_IMAGE_DOWNLOADS=4
PIPELINE_RETRY_FAILED_IMAGES=false
DISCOVERY_RUN_LEASE_MS=1800000

# Proximity uses bundled Census geography locally, with no routing credentials.
